# SEBM Backend Environment Variables Template
# Copy this file to .env and adjust values for local development.
# Never commit real credentials or .env to version control.

# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration
# Default development values align with docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sebm
DB_USER=sebm
DB_PASSWORD=sebm_dev_password
DB_SSL=false

# Connection Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=2000

# Optional Database Connection String (overrides individual DB_* fields if provided)
# DATABASE_URL=postgresql://sebm:sebm_dev_password@localhost:5432/sebm
